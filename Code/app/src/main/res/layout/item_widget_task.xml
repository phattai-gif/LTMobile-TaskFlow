<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingLeft="4dp"
    android:paddingTop="7dp"
    android:paddingRight="4dp"
    android:paddingBottom="7dp">

    <!-- Clickable checkbox to toggle completion -->
    <ImageView
        android:id="@+id/widget_item_checkbox"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="Toggle complete"
        android:padding="2dp"
        android:src="@drawable/ic_widget_circle_outline" />

    <!-- Task details (Clickable to view details) -->
    <LinearLayout
        android:id="@+id/widget_item_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#0F172A"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#64748B"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Priority tag with rounded pill background -->
    <TextView
        android:id="@+id/widget_item_priority"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingLeft="8dp"
        android:paddingTop="3dp"
        android:paddingRight="8dp"
        android:paddingBottom="3dp"
        android:textSize="10sp"
        android:textStyle="bold" />

    <!-- Edit Button (Clickable to edit task directly) -->
    <ImageView
        android:id="@+id/widget_item_btn_edit"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_widget_btn_icon"
        android:contentDescription="Edit task"
        android:padding="6dp"
        android:src="@drawable/ic_widget_edit" />
</LinearLayout>
