<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingLeft="4dp"
    android:paddingTop="6dp"
    android:paddingRight="4dp"
    android:paddingBottom="6dp">

    <!-- Clickable checkbox to toggle completion -->
    <ImageView
        android:id="@+id/widget_item_checkbox"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="Toggle complete"
        android:padding="2dp"
        android:src="@drawable/ic_widget_circle_outline" />

    <!-- Task details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/widget_item_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Priority tag -->
    <TextView
        android:id="@+id/widget_item_priority"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:paddingLeft="6dp"
        android:paddingTop="2dp"
        android:paddingRight="6dp"
        android:paddingBottom="2dp"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
